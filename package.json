{
  "name": "the-southern-rebellion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run images",
    "dev": "vite",
    "images": "node scripts/build-images.mjs",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run images && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "todos": "node scripts/list-todos.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/libre-franklin": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
